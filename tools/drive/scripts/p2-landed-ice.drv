# p2-landed-ice.drv - Phase 2 tour: landed at a surface port on an ice moon.
#
# Verifies: landed views on ice: sky, ground, the port's pad and buildings.
# Run:  tools/p2shots --routes landed-ice --base BASE --branch BRANCH
# Expect: 01 the station hall, not the cockpit, 02-03 the next two views of
#         the view cycle (the ship from outside), each paused.
# Each shot pauses the game (Esc) and resumes it at 1x (Shift+F1); the
# pointer is parked off the controls so no hover tip is drawn.

wait 6000
key space
wait 2000
key 1             # start position 1: landed at a surface port on an ice moon
wait 11000
mouse 2 120
wait 500
sdlkey esc
wait 600
shot 01-front
sdlkey f1 shift
mouse 8 193       # the view icon cycles the views
wait 300
click
wait 2500
mouse 2 120
wait 300
sdlkey esc
wait 600
shot 02-view2
sdlkey f1 shift
mouse 8 193
wait 300
click
wait 2500
mouse 2 120
wait 300
sdlkey esc
wait 600
shot 03-view3
quit
