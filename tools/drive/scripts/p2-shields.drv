# Comms, then launch: lift off and climb clear of the pad.
mouse 57 193
wait 300
click 200
wait 2500
mouse 171 57
wait 300
click 200
wait 3000
mouse 263 193
wait 300
click 200
wait 2000
mouse 2 120
wait 12000
# Pitch the nose down a little with the right button held.
mouse 160 100
press right
move 0 8 25 20
release right
wait 1000
# The view icon twice for the external view.
mouse 8 193
wait 300
click 200
wait 2000
mouse 8 193
wait 300
click 200
wait 2000
mouse 2 120
wait 300
sdlkey esc
wait 500
shot 01-ext
sdlkey f1 shift
wait 1000
# Three bursts of the laser at the port; its patrols answer.
log FIRE
keydown space
wait 3000
keyup space
wait 2000
keydown space
wait 3000
keyup space
wait 2000
keydown space
wait 3000
keyup space
# Short pauses while the return fire lands: a hit held in the pause stays still.
wait 3000
