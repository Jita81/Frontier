THIS=Makefile-C
VERSION=20060623

SRCOBJS := audio.o hostcall.o keymap.o main.o shortcut.o input.o joystick.o ini.o

COMPILER ?= gcc
CC := $(CROSS_COMPILE)$(COMPILER)

UNAME_S := $(shell uname -s)

# the toolchain's sysroot sdl-config when cross compiling, else the one in PATH
# (clang, the macOS compiler, has no --print-sysroot)
SYSROOT_SDL_CONFIG := $(shell $(CC) --print-sysroot 2>/dev/null)/usr/bin/sdl-config
SDL_CONFIG ?= $(if $(wildcard $(SYSROOT_SDL_CONFIG)),$(SYSROOT_SDL_CONFIG),sdl-config)
SDL_CFLAGS := $(shell $(SDL_CONFIG) --cflags)
SDL_LIBS := $(shell $(SDL_CONFIG) --libs)

# include/library paths of libvorbis/libogg when they are not in the system
# ones (Homebrew on macOS)
VORBIS_CFLAGS := $(shell pkg-config --cflags vorbisfile 2>/dev/null)
VORBIS_LDFLAGS := $(shell pkg-config --libs-only-L vorbisfile vorbis ogg 2>/dev/null)

# -fwrapv: the translated 68k code relies on signed 32-bit wraparound (overflow
# flag); without it optimised clang builds hang on planets
CFLAGS := -O3 -fomit-frame-pointer -fwrapv -Wall -Wno-unused $(SDL_CFLAGS) $(VORBIS_CFLAGS) -DOGG_MUSIC

LIBS := $(VORBIS_LDFLAGS) -lvorbisfile -lvorbis -logg $(SDL_LIBS)

WITH_GL=y
ifeq ($(WITH_GL),y)
	SRCOBJS += gl.o
	CFLAGS += -DWITH_GL
ifeq ($(UNAME_S),Darwin)
	LIBS += -framework OpenGL
	CFLAGS += -DGL_SILENCE_DEPRECATION
else
	LIBS += -lGL -lGLU
endif
else
	SRCOBJS += soft.o
ifeq ($(UNAME_S),Darwin)
	# no SDL_image for SDL 1.2 on Homebrew: soft.c reads cursor.png with libpng
	CFLAGS += -DNO_SDL_IMAGE $(shell pkg-config --cflags libpng)
	LIBS += $(shell pkg-config --libs libpng)
else
	LIBS += -lSDL_image
endif
endif

OBJS := fe2.s.o host.o \
	$(addprefix src/,$(SRCOBJS))
TARGET := frontier

.PHONY: all $(TARGET) allclean clean

all: $(TARGET)

$(TARGET): fe2.s.c
	$(MAKE) -f $(THIS) gen
	$(CC) $(CFLAGS) $(LIBS) $(OBJS) gen/*.o -o $@

gen: $(patsubst %.c,%.o,$(wildcard gen/*.c)) $(OBJS)

as68k/as68k:
	$(MAKE) -C as68k/

fe2.s.c: as68k/as68k
	mkdir -p gen
	as68k/as68k --output-c fe2.s

clean:
	rm -rf fe2.s.bin $(OBJS) gen fe2.s.c fixups.h $(TARGET)

allclean: clean
	$(MAKE) -C as68k/ clean

# To make a nice clean tarball
dist:
	$(MAKE) -f Makefile-i386 clean
	$(MAKE) -f $(THIS) allclean
	mkdir frontvm3-$(VERSION)
	mkdir frontvm3-$(VERSION)/as68k
	mkdir frontvm3-$(VERSION)/dis68k
	mkdir frontvm3-$(VERSION)/src
	mkdir frontvm3-$(VERSION)/savs
	#mkdir frontvm3-$(VERSION)/sfx
	#mkdir frontvm3-$(VERSION)/music
	cp as68k/* frontvm3-$(VERSION)/as68k
	cp dis68k/* frontvm3-$(VERSION)/dis68k
	cp src/* frontvm3-$(VERSION)/src
	#cp sfx/* frontvm3-$(VERSION)/sfx
	#cp music/* frontvm3-$(VERSION)/music
	cp fe2.s frontvm3-$(VERSION)
	cp m68000.h frontvm3-$(VERSION)
	cp _host.c frontvm3-$(VERSION)
	cp notes.txt frontvm3-$(VERSION)
	cp benchmarks.txt frontvm3-$(VERSION)
	cp README frontvm3-$(VERSION)
	cp TODO frontvm3-$(VERSION)
	cp Makefile-i386 frontvm3-$(VERSION)
	cp Makefile-C frontvm3-$(VERSION)
	cp Makefile-mingw frontvm3-$(VERSION)
	tar cvjf frontvm3-$(VERSION).tar.bz2 frontvm3-$(VERSION)
	rm -rf frontvm3-$(VERSION)

# save bandwidth...
audio-dist:
	mkdir frontvm-audio-$(VERSION)
	mkdir frontvm-audio-$(VERSION)/sfx
	mkdir frontvm-audio-$(VERSION)/music
	cp sfx/* frontvm-audio-$(VERSION)/sfx
	cp music/* frontvm-audio-$(VERSION)/music
	tar cvjf frontvm-audio-$(VERSION).tar.bz2 frontvm-audio-$(VERSION)
	rm -rf frontvm-audio-$(VERSION)

