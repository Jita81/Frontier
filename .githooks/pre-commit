#!/usr/bin/env bash
# Refuse commits that stage Frontier Developments game data (fe2.s and friends)
# or a cached GL id that nothing clears when the context goes.
# Install once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
[ ! -x tools/check-gl-forget ] || tools/check-gl-forget --staged || exit 1
exec tools/check-no-game-data.sh --staged
